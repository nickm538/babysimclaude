# Copy to .env for local development (Railway: set these as service variables).
PORT=3000
# Postgres connection string. Leave unset to use a JSON file store in ./data (dev only).
DATABASE_URL=
# Random string used to sign session tokens. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Anthropic API key for the live baby chat. Without it the chat uses the built-in rule-based responder.
ANTHROPIC_API_KEY=
# Optional: model for the baby chat (default claude-opus-5; claude-haiku-4-5 is cheaper/faster).
BABY_LLM_MODEL=claude-opus-5
# Where the JSON file store lives when DATABASE_URL is not set.
DATA_DIR=./data
NODE_ENV=production
# Optional, local testing only: enables POST /api/games/:id/debug/advance
CRADLE_DEBUG=
