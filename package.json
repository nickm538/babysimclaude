{
  "name": "cradle",
  "version": "1.0.0",
  "description": "Cradle — a real-time, first-person newborn raising simulation (Three.js + Node + Postgres).",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "three": "0.170.0",
    "ws": "^8.18.0"
  }
}
